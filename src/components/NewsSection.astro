---
import { newsItems } from "../data/news";
const featuredItems = newsItems.slice(0, 5);
---

<section class="news-section" aria-labelledby="news-title">
  <div class="news-section__header">
    <div>
      <p class="hero__eyebrow">WASAS ULL</p>
      <h2 id="news-title">Avances del proyecto</h2>
    </div>
    <a class="news-section__link" href="/noticias">Ver todas las novedades</a>
  </div>
  <div class="news-grid">
    {featuredItems.map((item) => (
      <article class="news-card">
        <div class="news-card__visual"><img src={item.images[0].src} alt={item.images[0].alt} loading="lazy" /></div>
        <div class="news-card__body">
          <div class="news-card__meta">
            {item.date && <span>{item.date}</span>}
            <strong class={`news-card__tag news-card__tag--${item.tone}`}>{item.tag}</strong>
          </div>
          <h3>{item.title}</h3>
          <p>{item.excerpt}</p>
          <a class="news-card__link" href={`/noticias/${item.slug}`}>
            Leer más <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
