---
// Sección de novedades con un listado editorial de avances del proyecto.
const newsItems = [
  {
    date: "28 abril 2024",
    tag: "Evento",
    tone: "violet",
    visual: "beach",
    title: "Jornada inicial del proyecto WASAS",
    text: "Compartimos los objetivos, las primeras líneas de trabajo y el enfoque científico del proyecto.",
  },
  {
    date: "15 abril 2024",
    tag: "Actividad",
    tone: "blue",
    visual: "coast",
    title: "Sesiones con jóvenes en la playa",
    text: "Deporte, conciencia ambiental y bienestar en conexión con el entorno costero.",
  },
  {
    date: "02 abril 2024",
    tag: "Noticia",
    tone: "orange",
    visual: "workshop",
    title: "Talleres sobre ecoansiedad",
    text: "Espacios de diálogo y herramientas prácticas para transformar la preocupación climática.",
  },
  {
    date: "18 marzo 2024",
    tag: "Investigación",
    tone: "blue",
    visual: "data",
    title: "Evaluaciones ULL en marcha",
    text: "Aplicación de cuestionarios y análisis de datos en las playas prioritarias.",
  },
  {
    date: "05 marzo 2024",
    tag: "Multimedia",
    tone: "orange",
    visual: "media",
    title: "Producción de material audiovisual",
    text: "Documentando cada paso para compartir aprendizajes y resultados.",
  },
];
---

<section class="news-section" aria-labelledby="news-title">
  <div class="news-section__header">
    <div>
      <p class="hero__eyebrow">WASAS ULL</p>
      <h2 id="news-title">Avances del proyecto</h2>
    </div>
    <a class="news-section__link" href="/noticias">Ver todas las novedades</a>
  </div>

  <div class="news-grid">
    {
      newsItems.map((item) => (
        <article class="news-card">
          <div class={`news-card__visual news-card__visual--${item.visual}`} aria-hidden="true" />
          <div class="news-card__body">
            <div class="news-card__meta">
              <span>{item.date}</span>
              <strong class={`news-card__tag news-card__tag--${item.tone}`}>
                {item.tag}
              </strong>
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="news-card__link" href="/noticias">
              Leer más <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
