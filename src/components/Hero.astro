---
// Componente del hero principal.
---

<section class="hero-wrapper" aria-labelledby="hero-title">
  <div class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
      <p class="hero__eyebrow">PROYECTO WASAS ULL</p>
      <h1 id="hero-title" class="hero__title">WASAS ULL</h1>
      <p class="hero__subtitle">
        Del mar, la arena y la ciencia a la <span class="hero__accent">acción climática</span>
      </p>

      <div class="hero__actions">
        <a class="hero__button hero__button--primary" href="/noticias"
          >Ver avances</a
        >
        <a class="hero__button hero__button--secondary" href="/contacto"
          >Contactar</a
        >
      </div>
    </div>

  </div>
</section>
